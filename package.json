{
  "name": "telegallery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TeleDrive \u2014 unlimited personal cloud storage powered by your Telegram account",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.6",
    "@sveltejs/kit": "^3.4.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "svelte": "^5.59.2",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.0",
    "vite": "^8.4.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "lucide-svelte": "^1.0.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
