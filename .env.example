# ---- Telegram (required for real storage + login) ------------------------------
# 1. Message @BotFather -> /newbot, copy the token here.
TELEGRAM_BOT_TOKEN=
# 2. The bot's username, without the @. Needed by the Telegram Login Widget.
TELEGRAM_BOT_USERNAME=
# 3. Where files are stored. Send any message to your bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
#    Leave empty to store files in the signed-in user's own chat with the bot.
TELEGRAM_STORAGE_CHAT_ID=
# Optional: point to a self-hosted Bot API server to lift the 50MB upload /
# 20MB download limits of api.telegram.org.
# TELEGRAM_API_BASE=http://localhost:8081

# ---- App ----------------------------------------------------------------------
# Random string used to sign cookies.
SESSION_SECRET=change-me-to-a-long-random-string
SITE_NAME=TeleDrive
# Where the SQLite database and local blob cache live.
DATA_DIR=data
# Allow the "Try the demo account" button on the login page (default true).
ALLOW_DEMO_LOGIN=true
# Largest single upload accepted, in bytes (default 4 GiB).
MAX_FILE_SIZE=4294967296
# Size of each chunk stored as one Telegram document (default 45 MB, max 50 MB
# on the public Bot API; you can raise this with a local Bot API server).
TELEGRAM_CHUNK_SIZE=47185920
